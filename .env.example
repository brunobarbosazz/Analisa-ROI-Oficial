# Em desenvolvimento local, mantenha o modo demo. Em Preview/Production use false.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000

# O backend usa somente a URL e a publishable key. Nenhuma chave privilegiada
# do Supabase é necessária no runtime desta aplicação.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
